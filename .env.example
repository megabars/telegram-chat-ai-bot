TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

OPENAI_MODEL=gpt-6-luna

# Разрешённые Telegram chat_id, через запятую. Пусто — любые группы.
ALLOWED_CHAT_IDS=
MAX_INPUT_CHARS=12000
MAX_CONCURRENT_REQUESTS=5
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_PERIOD_SECONDS=60
OPENAI_TIMEOUT_SECONDS=60
MAX_OUTPUT_TOKENS=2048
LOG_LEVEL=INFO

REPLY_CONTEXT_ENABLED=true
REPLY_CONTEXT_MAX_DEPTH=30
REPLY_CONTEXT_MAX_CHARS=30000
REPLY_CONTEXT_FETCH_TIMEOUT_SECONDS=10
TELEGRAM_MTPROTO_SESSION_PATH=/var/lib/telegram-openai-bot/telegram.session

LOCAL_HISTORY_ENABLED=true
LOCAL_HISTORY_DB_PATH=/var/lib/telegram-openai-bot/history.sqlite3
LOCAL_HISTORY_MAX_MESSAGES=5000
LOCAL_HISTORY_CLEANUP_THRESHOLD=5100
CONTEXT_COMMAND_DEFAULT_MESSAGES=50
CONTEXT_COMMAND_MAX_MESSAGES=200
CONTEXT_MAX_CHARS=50000
CONTEXT_RESPECT_TOPICS=true

# Optional scheduled AI requests; disabled until explicitly enabled for selected chats.
DAILY_DIGEST_ENABLED=false
DAILY_DIGEST_CHAT_IDS=
DAILY_DIGEST_HOUR=9
DAILY_DIGEST_TIMEZONE=Asia/Tomsk
DAILY_DIGEST_CONTEXT_CHARS=120000
DAILY_DIGEST_MAX_OUTPUT_TOKENS=600

# Explicitly opt in to sending mentioned photos to OpenAI for analysis.
PHOTO_ANALYSIS_ENABLED=false
PHOTO_DAILY_USER_LIMIT=20
PHOTO_DAILY_CHAT_LIMIT=20
PHOTO_DAILY_TIMEZONE=Asia/Tomsk

# Optional image generation, photo editing and 2-4 photo mixing; persisted daily quotas.
IMAGE_GENERATION_ENABLED=false
IMAGE_GENERATION_MODEL=gpt-image-2.5-flare
IMAGE_GENERATION_TIMEOUT_SECONDS=180
IMAGE_DAILY_USER_LIMIT=3
IMAGE_DAILY_CHAT_LIMIT=10
IMAGE_DAILY_TIMEZONE=Asia/Tomsk
